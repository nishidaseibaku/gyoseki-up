rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Microsoft 365 (Entra ID) でログイン済みのユーザーのみアクセス可。
    // 組織外アカウントの排除は Azure 側のアプリ登録を「この組織のディレクトリのみ」
    // (シングルテナント) にすることで担保する。

    // 同期マスタ（氏名・部門）はマスタ配信システムからの同期専用。
    // クライアントからは閲覧のみ許可し、書き込みは Cloud Function (Admin SDK) だけが行う
    // （Admin SDK はセキュリティルールをバイパスするため、ここで write:false でも同期は動作する）。
    match /names/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /departments/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 業績実績・分類・設定・同期リクエストは認証済みユーザーが読み書き可。
    match /initiatives/{docId} {
      allow read, write: if request.auth != null;
    }
    match /categories/{docId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
    match /syncRequests/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
