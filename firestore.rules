rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー名/パスワードでログイン済みのユーザーのみアクセス可。
    // アカウントは管理者が tools/manage_users.py で事前作成するため、
    // セルフサインアップは無く外部の人間がアカウントを作ることはできない。

    // ログインユーザー自身のプロフィール（氏名）。
    // 読み取りは本人のみ。書き込みは、設定画面の「氏名」からログインアカウントを
    // 作成する際にクライアントから書き込まれるため、他のマスタと同じく認証済みなら誰でも可とする
    // （管理者スクリプト tools/manage_users.py は Admin SDK 経由でこのルールをバイパスする）。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null;
    }

    // 社・課・氏名マスタ（社→課→氏名の階層）は自前で保有し、
    // 認証済みユーザーなら誰でも読み書き可（分類・業績実績・設定と同じ扱い）。
    match /companies/{docId} {
      allow read, write: if request.auth != null;
    }
    match /sections/{docId} {
      allow read, write: if request.auth != null;
    }
    match /names/{docId} {
      allow read, write: if request.auth != null;
    }

    // 業績実績・分類・設定は認証済みユーザーが読み書き可。
    match /initiatives/{docId} {
      allow read, write: if request.auth != null;
    }
    match /categories/{docId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // 実績の管理番号を採番するためのカウンタ。
    match /counters/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
